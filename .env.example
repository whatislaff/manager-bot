# Токен от @BotFather
BOT_TOKEN=123456:ABC...

# Ссылка на РЕДАКТИРОВАНИЕ формы (или просто её ID)
FORM_ID=https://docs.google.com/forms/d/XXXXXXXXXXXX/edit

# Кому слать заявки. Узнать: запусти бота с пустым полем и напиши ему /start
# Несколько человек через запятую: 111111,222222
ADMIN_CHAT_IDS=

# JSON-ключ сервисного аккаунта Google
GOOGLE_CREDENTIALS=service_account.json

# Как часто проверять форму, в секундах
POLL_SECONDS=60

TIMEZONE=Europe/Warsaw
